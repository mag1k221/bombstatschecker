# All variables are optional. Defaults are shown.
# Contact string sent in the User-Agent to the official Albion Online API (be a good citizen).
ALBION_API_CONTACT=
# Minimum milliseconds between upstream requests (global, per server instance).
ALBION_API_MIN_INTERVAL_MS=200
# Cache lifetime for retrieved battle data, in seconds.
BATTLE_CACHE_TTL_SECONDS=600
# Analyses allowed per client IP per minute.
ANALYZE_RATE_LIMIT_PER_MINUTE=12
PRICES_RATE_LIMIT_PER_MINUTE=20
# Set to "false" to hide the clearly labeled demo mode.
NEXT_PUBLIC_ENABLE_DEMO=true
